# Normalise line endings: LF in the repo and in working copies on every OS,
# so shell scripts run on Linux/macOS CI and diffs stay clean on Windows.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ttf binary
*.otf binary
*.jar binary
*.keystore binary
*.jks binary
